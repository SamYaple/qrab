{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "virtualmachines.qrab.yapplesauce.com"
  },
  "spec": {
    "group": "qrab.yapplesauce.com",
    "names": {
      "kind": "VirtualMachine",
      "plural": "virtualmachines",
      "shortNames": [
        "qvm"
      ],
      "singular": "virtualmachine"
    },
    "scope": "Namespaced",
    "versions": [
      {
        "additionalPrinterColumns": [
          {
            "jsonPath": ".status.phase",
            "name": "Phase",
            "type": "string"
          },
          {
            "jsonPath": ".status.ready",
            "name": "Ready",
            "type": "boolean"
          },
          {
            "jsonPath": ".status.nodeName",
            "name": "Node",
            "type": "string"
          },
          {
            "jsonPath": ".status.resize.phase",
            "name": "Resize",
            "type": "string"
          }
        ],
        "name": "v1alpha1",
        "schema": {
          "openAPIV3Schema": {
            "description": "Auto-generated derived type for VirtualMachineSpec via `CustomResource`",
            "properties": {
              "spec": {
                "properties": {
                  "accelerator": {
                    "description": "`kvm` requests one `qrab.yapplesauce.com/kvm` device (CDI-injected\n/dev/kvm) and enables vCPU hot-plug; such Pods stay Pending on nodes\nwithout the qrab KVM device plugin. Changing it restarts the VM.",
                    "enum": [
                      "kvm",
                      "tcg"
                    ],
                    "type": "string"
                  },
                  "bootDisk": {
                    "default": "/opt/qrab/demo/boot.img",
                    "description": "Readonly UEFI boot disk inside the manager image. No direct kernel boot.",
                    "enum": [
                      "/opt/qrab/demo/boot.img"
                    ],
                    "maxLength": 4096,
                    "minLength": 2,
                    "type": "string"
                  },
                  "cloudInit": {
                    "description": "cloud-init NoCloud seed, attached as a read-only `cidata` disk.\nOpt-in; adding, changing or removing it restarts the VM.",
                    "nullable": true,
                    "properties": {
                      "hostname": {
                        "description": "Guest hostname, a DNS label. Defaults to the VM name.",
                        "nullable": true,
                        "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
                        "type": "string"
                      },
                      "userData": {
                        "description": "user-data passed through verbatim, at most 32 KiB. It is stored in\nthe VM's operator-owned ConfigMap; reference no secret you would not\nput there. Absent means an empty `#cloud-config`.",
                        "maxLength": 32768,
                        "nullable": true,
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "components": {
                    "default": {
                      "bmc": {
                        "enabled": true
                      },
                      "redfish": {
                        "adminGroups": [],
                        "adminSubjects": [],
                        "enabled": false,
                        "viewerGroups": [],
                        "viewerSubjects": []
                      }
                    },
                    "description": "Optional sidecars. The manager container always owns the VM.",
                    "properties": {
                      "bmc": {
                        "default": {
                          "enabled": true
                        },
                        "properties": {
                          "enabled": {
                            "default": true,
                            "description": "The OIDC browser console and dashboard. Enabled unless set to false.",
                            "type": "boolean"
                          }
                        },
                        "type": "object"
                      },
                      "redfish": {
                        "default": {
                          "adminGroups": [],
                          "adminSubjects": [],
                          "enabled": false,
                          "viewerGroups": [],
                          "viewerSubjects": []
                        },
                        "properties": {
                          "adminGroups": {
                            "default": [],
                            "description": "Kanidm group UUIDs whose members may read and reset the VM.",
                            "items": {
                              "type": "string"
                            },
                            "maxItems": 16,
                            "type": "array"
                          },
                          "adminSubjects": {
                            "default": [],
                            "description": "Subject UUIDs that may read and reset the VM.",
                            "items": {
                              "type": "string"
                            },
                            "maxItems": 128,
                            "type": "array"
                          },
                          "enabled": {
                            "default": false,
                            "description": "A DMTF Redfish API authenticated by OIDC bearer tokens.",
                            "type": "boolean"
                          },
                          "eventDestinations": {
                            "description": "Exact HTTPS event receiver URLs, without credentials, query, fragment\nor non-443 ports. Empty disables outbound Redfish event subscriptions.",
                            "items": {
                              "type": "string"
                            },
                            "maxItems": 32,
                            "type": "array"
                          },
                          "stateVolumeClaim": {
                            "description": "Explicit separate PVC for Redfish subscription state. The operator never\ncreates or deletes it; it must not be the VM's firmware/TPM state PVC.",
                            "nullable": true,
                            "type": "string"
                          },
                          "telemetryIntervalSeconds": {
                            "description": "Optional periodic Redfish metric history cadence. Absent keeps reports\non demand and avoids idle VM metric queries; enabled triggers still poll.",
                            "format": "int32",
                            "maximum": 3600.0,
                            "minimum": 5.0,
                            "nullable": true,
                            "type": "integer"
                          },
                          "viewerGroups": {
                            "default": [],
                            "description": "Kanidm group UUIDs whose members have read-only access.",
                            "items": {
                              "type": "string"
                            },
                            "maxItems": 16,
                            "type": "array"
                          },
                          "viewerSubjects": {
                            "default": [],
                            "description": "Subject UUIDs with read-only access.",
                            "items": {
                              "type": "string"
                            },
                            "maxItems": 128,
                            "type": "array"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "console": {
                    "description": "Browser console settings; required while `components.bmc` is enabled.",
                    "nullable": true,
                    "properties": {
                      "adminGroups": {
                        "default": [],
                        "description": "Kanidm group UUIDs whose members have full BMC access.",
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 16,
                        "type": "array"
                      },
                      "allowedSubjects": {
                        "default": [],
                        "description": "Subject UUIDs with full (admin) BMC access.",
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 128,
                        "type": "array"
                      },
                      "publicUrl": {
                        "description": "Exact HTTPS origin of the BMC's own browser login and UI.\nService/Ingress/certificate and IdP callback are separate. Omit it for a\nBMC reached only through the dashboard, which needs the operator's BMC\nbearer-token settings.",
                        "nullable": true,
                        "type": "string"
                      },
                      "viewerGroups": {
                        "default": [],
                        "description": "Kanidm group UUIDs whose members have read-only BMC access.",
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 16,
                        "type": "array"
                      },
                      "viewerSubjects": {
                        "default": [],
                        "description": "Subject UUIDs with read-only BMC access: status, events and redacted configuration.",
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 128,
                        "type": "array"
                      }
                    },
                    "type": "object"
                  },
                  "cpus": {
                    "default": 1,
                    "format": "int32",
                    "maximum": 256.0,
                    "minimum": 1.0,
                    "type": "integer"
                  },
                  "disks": {
                    "description": "Disks the operator provisions, exports, grows and fences through the\nstorage service. CHAP credentials are generated into owned Secrets.",
                    "items": {
                      "description": "A storage-service disk. Target, portal, CHAP account and Secret are derived\nfrom the VM UID and disk ID; a CR cannot point it at another LUN.",
                      "properties": {
                        "baseImage": {
                          "description": "Immutable CoW source; absent provisions a blank thick disk.",
                          "properties": {
                            "generation": {
                              "format": "uint32",
                              "maximum": 999999.0,
                              "minimum": 1.0,
                              "type": "integer"
                            },
                            "name": {
                              "maxLength": 32,
                              "minLength": 1,
                              "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$",
                              "type": "string"
                            }
                          },
                          "required": [
                            "generation",
                            "name"
                          ],
                          "type": "object"
                        },
                        "bootIndex": {
                          "format": "int32",
                          "maximum": 65535.0,
                          "minimum": 0.0,
                          "nullable": true,
                          "type": "integer"
                        },
                        "id": {
                          "pattern": "^[a-z0-9]([a-z0-9-]{0,18}[a-z0-9])?$",
                          "type": "string"
                        },
                        "readOnly": {
                          "default": false,
                          "type": "boolean"
                        },
                        "sizeBytes": {
                          "description": "Grow-only capacity, 16MiB..1TiB in whole MiB. Growth restarts the VM.",
                          "format": "int64",
                          "maximum": 1099511627776.0,
                          "minimum": 16777216.0,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "id",
                        "sizeBytes"
                      ],
                      "type": "object",
                      "x-kubernetes-validations": [
                        {
                          "message": "sizeBytes may only grow; ZFS volumes are never shrunk",
                          "rule": "self.sizeBytes >= oldSelf.sizeBytes"
                        },
                        {
                          "message": "baseImage is immutable; use a new disk id for another source",
                          "rule": "has(self.baseImage) == has(oldSelf.baseImage) && (!has(self.baseImage) || self.baseImage == oldSelf.baseImage)"
                        }
                      ]
                    },
                    "maxItems": 8,
                    "type": "array",
                    "x-kubernetes-list-map-keys": [
                      "id"
                    ],
                    "x-kubernetes-list-type": "map"
                  },
                  "firmwareCatalogVolumeClaim": {
                    "description": "Explicit read-only approved firmware catalog PVC. Its root-owned sealed\nmanifest and CODE artifacts must satisfy manager catalog validation.",
                    "nullable": true,
                    "type": "string"
                  },
                  "image": {
                    "description": "Optional immutable manager image; defaults to the operator's release pin.",
                    "nullable": true,
                    "pattern": "^zot\\.yapplesauce\\.com/qrab/manager@sha256:[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "iscsiDisks": {
                    "default": [],
                    "items": {
                      "properties": {
                        "bootIndex": {
                          "format": "int32",
                          "maximum": 65535.0,
                          "minimum": 0.0,
                          "nullable": true,
                          "type": "integer"
                        },
                        "id": {
                          "pattern": "^[a-z0-9]([a-z0-9-]{0,18}[a-z0-9])?$",
                          "type": "string"
                        },
                        "lun": {
                          "default": 0,
                          "format": "int32",
                          "maximum": 16383.0,
                          "minimum": 0.0,
                          "type": "integer"
                        },
                        "passwordSecret": {
                          "properties": {
                            "key": {
                              "default": "password",
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "name"
                          ],
                          "type": "object"
                        },
                        "portal": {
                          "type": "string"
                        },
                        "readOnly": {
                          "default": false,
                          "type": "boolean"
                        },
                        "target": {
                          "type": "string"
                        },
                        "username": {
                          "maxLength": 223,
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "passwordSecret",
                        "portal",
                        "target",
                        "username"
                      ],
                      "type": "object",
                      "x-kubernetes-validations": [
                        {
                          "message": "disk identity is immutable; use a new id for deliberate replacement",
                          "rule": "self.id == oldSelf.id && self.portal == oldSelf.portal && self.target == oldSelf.target && self.lun == oldSelf.lun"
                        }
                      ]
                    },
                    "maxItems": 8,
                    "type": "array",
                    "x-kubernetes-list-map-keys": [
                      "id"
                    ],
                    "x-kubernetes-list-type": "map"
                  },
                  "maxCpus": {
                    "description": "vCPU hot-plug ceiling fixed at boot. Defaults to 4x the booted count\n(at most 64). Growth beyond it, or changing it, restarts the VM.",
                    "format": "int32",
                    "maximum": 256.0,
                    "minimum": 1.0,
                    "type": "integer"
                  },
                  "maxMemoryMiB": {
                    "description": "Memory hot-plug ceiling fixed at boot. Defaults to 4x the booted size\n(at most +64 GiB). Growth beyond it, or changing it, restarts the VM.",
                    "format": "int32",
                    "maximum": 1048576.0,
                    "minimum": 256.0,
                    "type": "integer"
                  },
                  "mediaVolumeClaim": {
                    "description": "Explicit read-only catalog PVC of approved virtual media. Mounted only\ninto the manager; no file uploads, PVC creation or garbage collection.",
                    "nullable": true,
                    "type": "string"
                  },
                  "memoryMiB": {
                    "default": 512,
                    "format": "int32",
                    "maximum": 1048576.0,
                    "minimum": 256.0,
                    "type": "integer"
                  },
                  "nics": {
                    "description": "Guest NICs. Each is backed by its own NIC Pod (`<vm>-nic-<name>`)\nwhose IP, Cilium identity and security-group labels are the NIC's.",
                    "items": {
                      "description": "A guest NIC. Guest traffic leaves through its NIC Pod, never the VM Pod.",
                      "properties": {
                        "name": {
                          "pattern": "^[a-z0-9]([a-z0-9-]{0,13}[a-z0-9])?$",
                          "type": "string"
                        },
                        "securityGroups": {
                          "description": "Each becomes the NIC Pod label `sg.qrab.yapplesauce.com/<group>: \"\"`\nfor CiliumNetworkPolicies to select. Changes apply without a restart.",
                          "items": {
                            "description": "A DNS label naming a security group.",
                            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
                            "type": "string"
                          },
                          "maxItems": 8,
                          "type": "array",
                          "x-kubernetes-list-type": "set"
                        }
                      },
                      "required": [
                        "name"
                      ],
                      "type": "object"
                    },
                    "maxItems": 4,
                    "type": "array",
                    "x-kubernetes-list-map-keys": [
                      "name"
                    ],
                    "x-kubernetes-list-type": "map"
                  },
                  "restartNonce": {
                    "default": "",
                    "description": "Change this value to restart without discarding the retained identity.",
                    "maxLength": 128,
                    "type": "string"
                  },
                  "running": {
                    "default": true,
                    "description": "Desired power state. A running VM is recreated after exit or Pod loss.",
                    "type": "boolean"
                  },
                  "secureBootCapable": {
                    "description": "Select explicit secure-capable OVMF with SMM-protected variable flash.\nKey enrollment and requested enablement remain separate operations.",
                    "type": "boolean"
                  },
                  "stateVolumeClaim": {
                    "description": "Existing filesystem PVC. Its UEFI/vTPM identity is never garbage collected.",
                    "maxLength": 253,
                    "minLength": 1,
                    "type": "string",
                    "x-kubernetes-validations": [
                      {
                        "message": "stateVolumeClaim is immutable; identity migration must be deliberate",
                        "rule": "self == oldSelf"
                      }
                    ]
                  },
                  "storageNode": {
                    "description": "Initial iSCSI support is node-pinned; migration requires target fencing.",
                    "type": "string"
                  }
                },
                "required": [
                  "stateVolumeClaim"
                ],
                "type": "object"
              },
              "status": {
                "nullable": true,
                "properties": {
                  "disks": {
                    "default": [],
                    "items": {
                      "description": "Observed storage-service state for one provisioned disk.",
                      "properties": {
                        "capacityBytes": {
                          "format": "uint64",
                          "minimum": 0.0,
                          "type": "integer"
                        },
                        "generation": {
                          "description": "CHAP credential generation; increments only after a verified fence.",
                          "format": "uint64",
                          "minimum": 0.0,
                          "type": "integer"
                        },
                        "id": {
                          "type": "string"
                        },
                        "phase": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "capacityBytes",
                        "generation",
                        "id",
                        "phase"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "message": {
                    "type": "string"
                  },
                  "nics": {
                    "default": [],
                    "items": {
                      "description": "Observed state of one guest NIC.",
                      "properties": {
                        "address": {
                          "description": "The address this NIC keeps across nodes (its one-address\nCiliumPodIPPool), when the operator hands out stable addresses.",
                          "nullable": true,
                          "type": "string"
                        },
                        "ip": {
                          "description": "The NIC Pod IP, which is also the guest's address on this NIC.",
                          "nullable": true,
                          "type": "string"
                        },
                        "mac": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "podName": {
                          "type": "string"
                        },
                        "ready": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "mac",
                        "name",
                        "podName",
                        "ready"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "nodeName": {
                    "nullable": true,
                    "type": "string"
                  },
                  "observedGeneration": {
                    "format": "int64",
                    "type": "integer"
                  },
                  "phase": {
                    "type": "string"
                  },
                  "placementNode": {
                    "description": "The node the VM runs on since its last live migration; replaces\n`spec.storageNode` as the scheduling pin.",
                    "nullable": true,
                    "type": "string"
                  },
                  "podName": {
                    "nullable": true,
                    "type": "string"
                  },
                  "podUid": {
                    "nullable": true,
                    "type": "string"
                  },
                  "ready": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "resize": {
                    "description": "In-place resource growth of the current Pod.",
                    "nullable": true,
                    "properties": {
                      "appliedCpus": {
                        "description": "Guest size whose limits the kubelet reports as applied.",
                        "format": "uint32",
                        "minimum": 0.0,
                        "nullable": true,
                        "type": "integer"
                      },
                      "appliedMemoryMiB": {
                        "format": "uint32",
                        "minimum": 0.0,
                        "nullable": true,
                        "type": "integer"
                      },
                      "bootCpus": {
                        "description": "Size and hot-plug ceilings this Pod's QEMU booted with.",
                        "format": "uint32",
                        "minimum": 0.0,
                        "type": "integer"
                      },
                      "bootMemoryMiB": {
                        "format": "uint32",
                        "minimum": 0.0,
                        "type": "integer"
                      },
                      "cpus": {
                        "description": "Guest size requested from the Pod's container resources.",
                        "format": "uint32",
                        "minimum": 0.0,
                        "type": "integer"
                      },
                      "maxCpus": {
                        "format": "uint32",
                        "minimum": 0.0,
                        "type": "integer"
                      },
                      "maxMemoryMiB": {
                        "format": "uint32",
                        "minimum": 0.0,
                        "type": "integer"
                      },
                      "memoryMiB": {
                        "format": "uint32",
                        "minimum": 0.0,
                        "type": "integer"
                      },
                      "message": {
                        "type": "string"
                      },
                      "phase": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "bootCpus",
                      "bootMemoryMiB",
                      "cpus",
                      "maxCpus",
                      "maxMemoryMiB",
                      "memoryMiB",
                      "message",
                      "phase"
                    ],
                    "type": "object"
                  },
                  "stateVolumeClaim": {
                    "description": "The state PVC holding the VM's UEFI/TPM identity now, when a live\nmigration moved it off `spec.stateVolumeClaim`.",
                    "nullable": true,
                    "type": "string"
                  },
                  "stateVolumeUid": {
                    "nullable": true,
                    "type": "string"
                  },
                  "storageRecovery": {
                    "description": "Administrator acknowledgment of hard target fencing after unclean loss.",
                    "nullable": true,
                    "type": "string"
                  },
                  "storageReleasedPodUid": {
                    "description": "Recorded only after clean drain, before deleting the previous Pod.",
                    "nullable": true,
                    "type": "string"
                  }
                },
                "required": [
                  "message",
                  "observedGeneration",
                  "phase",
                  "ready",
                  "reason"
                ],
                "type": "object"
              }
            },
            "required": [
              "spec"
            ],
            "title": "VirtualMachine",
            "type": "object",
            "x-kubernetes-validations": [
              {
                "message": "VM names must be at most 50 characters",
                "rule": "size(self.metadata.name) <= 50"
              },
              {
                "message": "storageNode is immutable; disk migration requires explicit fencing",
                "rule": "!has(oldSelf.spec.storageNode) || (has(self.spec.storageNode) && self.spec.storageNode == oldSelf.spec.storageNode)"
              },
              {
                "message": "cpus must not exceed maxCpus",
                "rule": "!has(self.spec.maxCpus) || self.spec.cpus <= self.spec.maxCpus"
              },
              {
                "message": "memoryMiB must not exceed maxMemoryMiB",
                "rule": "!has(self.spec.maxMemoryMiB) || self.spec.memoryMiB <= self.spec.maxMemoryMiB"
              },
              {
                "message": "console is required while components.bmc is enabled",
                "rule": "has(self.spec.console) || (has(self.spec.components) && has(self.spec.components.bmc) && has(self.spec.components.bmc.enabled) && !self.spec.components.bmc.enabled)"
              }
            ]
          }
        },
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        }
      }
    ]
  }
}
