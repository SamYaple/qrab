{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "baseimages.qrab.yapplesauce.com"
  },
  "spec": {
    "group": "qrab.yapplesauce.com",
    "names": {
      "kind": "BaseImage",
      "plural": "baseimages",
      "shortNames": [
        "bimg"
      ],
      "singular": "baseimage"
    },
    "scope": "Namespaced",
    "versions": [
      {
        "additionalPrinterColumns": [
          {
            "jsonPath": ".spec.image",
            "name": "Image",
            "type": "string"
          },
          {
            "jsonPath": ".spec.generation",
            "name": "Gen",
            "type": "integer"
          },
          {
            "jsonPath": ".spec.title",
            "name": "Title",
            "type": "string"
          },
          {
            "jsonPath": ".status.phase",
            "name": "Phase",
            "type": "string"
          },
          {
            "jsonPath": ".spec.retired",
            "name": "Retired",
            "type": "boolean"
          }
        ],
        "name": "v1alpha1",
        "schema": {
          "openAPIV3Schema": {
            "description": "Auto-generated derived type for BaseImageSpec via `CustomResource`",
            "properties": {
              "spec": {
                "properties": {
                  "generation": {
                    "format": "int32",
                    "maximum": 999999.0,
                    "minimum": 1.0,
                    "type": "integer"
                  },
                  "image": {
                    "description": "Catalog name; VMs clone `image-<image>-g<generation>@sealed`.",
                    "maxLength": 32,
                    "minLength": 1,
                    "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$",
                    "type": "string"
                  },
                  "os": {
                    "maxLength": 32,
                    "minLength": 1,
                    "type": "string"
                  },
                  "retired": {
                    "default": false,
                    "description": "Stop new clones of this generation (existing VMs keep theirs).",
                    "type": "boolean"
                  },
                  "source": {
                    "properties": {
                      "format": {
                        "enum": [
                          "qcow2",
                          "raw"
                        ],
                        "type": "string"
                      },
                      "sha256": {
                        "description": "SHA-256 of the downloaded file, checked before anything parses it.",
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "url": {
                        "description": "HTTPS download URL; redirects must stay on HTTPS.",
                        "maxLength": 2048,
                        "minLength": 9,
                        "pattern": "^https://",
                        "type": "string"
                      }
                    },
                    "required": [
                      "format",
                      "sha256",
                      "url"
                    ],
                    "type": "object"
                  },
                  "title": {
                    "maxLength": 80,
                    "minLength": 1,
                    "type": "string"
                  },
                  "version": {
                    "maxLength": 32,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "generation",
                  "image",
                  "os",
                  "source",
                  "title",
                  "version"
                ],
                "type": "object"
              },
              "status": {
                "nullable": true,
                "properties": {
                  "adopted": {
                    "description": "The generation was already sealed (by `vm-image-import` or publish).",
                    "type": "boolean"
                  },
                  "attempts": {
                    "description": "Failed import attempts so far.",
                    "format": "int32",
                    "type": "integer"
                  },
                  "capacityBytes": {
                    "description": "The sealed volume's size; clones must be at least this big.",
                    "format": "int64",
                    "nullable": true,
                    "type": "integer"
                  },
                  "message": {
                    "type": "string"
                  },
                  "observedGeneration": {
                    "format": "int64",
                    "nullable": true,
                    "type": "integer"
                  },
                  "phase": {
                    "default": "Pending",
                    "enum": [
                      "Pending",
                      "Sealed",
                      "Retired",
                      "Failed",
                      "Inspecting",
                      "Staging",
                      "Writing",
                      "Sealing"
                    ],
                    "type": "string"
                  },
                  "sha256": {
                    "description": "SHA-256 of the sealed raw image, as the storage host measured it.",
                    "nullable": true,
                    "type": "string"
                  },
                  "sizeBytes": {
                    "description": "The image's raw size (the virtual size of the source).",
                    "format": "int64",
                    "nullable": true,
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "spec"
            ],
            "title": "BaseImage",
            "type": "object",
            "x-kubernetes-validations": [
              {
                "message": "a generation is immutable except retired; refresh with a new generation",
                "rule": "self.spec.image == oldSelf.spec.image && self.spec.generation == oldSelf.spec.generation && self.spec.title == oldSelf.spec.title && self.spec.os == oldSelf.spec.os && self.spec.version == oldSelf.spec.version && self.spec.source == oldSelf.spec.source"
              },
              {
                "message": "a retired generation stays retired",
                "rule": "!has(oldSelf.spec.retired) || !oldSelf.spec.retired || (has(self.spec.retired) && self.spec.retired)"
              }
            ]
          }
        },
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        }
      }
    ]
  }
}
