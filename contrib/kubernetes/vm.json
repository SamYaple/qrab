{
  "name": "qrab-demo",
  "memory_mib": 256,
  "cpus": 1,
  "accelerator": "tcg",
  "kernel": "/opt/qrab/demo/vmlinuz",
  "initrd": "/opt/qrab/demo/initramfs.gz",
  "kernel_args": "console=ttyS0 rdinit=/init panic=0 quiet",
  "runtime_dir": "/run/qrab",
  "startup_timeout_secs": 30,
  "shutdown_grace_secs": 5
}
