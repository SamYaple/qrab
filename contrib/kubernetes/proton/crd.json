{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "vpnprofiles.qrab.yapplesauce.com"
  },
  "spec": {
    "group": "qrab.yapplesauce.com",
    "names": {
      "kind": "VpnProfile",
      "plural": "vpnprofiles",
      "shortNames": [
        "vpnp"
      ],
      "singular": "vpnprofile"
    },
    "scope": "Namespaced",
    "versions": [
      {
        "additionalPrinterColumns": [
          {
            "jsonPath": ".status.server",
            "name": "Server",
            "type": "string"
          },
          {
            "jsonPath": ".status.exitCountry",
            "name": "Country",
            "type": "string"
          },
          {
            "jsonPath": ".status.load",
            "name": "Load",
            "type": "integer"
          },
          {
            "jsonPath": ".status.conditions[?(@.type==\"Ready\")].status",
            "name": "Ready",
            "type": "string"
          }
        ],
        "name": "v1alpha1",
        "schema": {
          "openAPIV3Schema": {
            "description": "Auto-generated derived type for VpnProfileSpec via `CustomResource`",
            "properties": {
              "spec": {
                "properties": {
                  "proton": {
                    "description": "Which Proton server, and the connection features bound to the key.",
                    "properties": {
                      "city": {
                        "description": "City for automatic selection.",
                        "maxLength": 64,
                        "minLength": 1,
                        "nullable": true,
                        "type": "string"
                      },
                      "country": {
                        "description": "Exit country (ISO 3166 alpha-2) for automatic selection.",
                        "nullable": true,
                        "pattern": "^[A-Za-z]{2}$",
                        "type": "string"
                      },
                      "features": {
                        "description": "Required server features. Secure Core and Tor servers are used only\nwhen listed here.",
                        "items": {
                          "description": "Logical-server feature bits, as Proton numbers them.",
                          "enum": [
                            "secureCore",
                            "tor",
                            "p2p",
                            "streaming",
                            "ipv6"
                          ],
                          "type": "string"
                        },
                        "maxItems": 5,
                        "type": "array"
                      },
                      "moderateNat": {
                        "default": false,
                        "description": "Moderate NAT, for games and calls that need it.",
                        "type": "boolean"
                      },
                      "netShield": {
                        "default": 1,
                        "description": "NetShield DNS filtering: 0 off, 1 malware, 2 malware, ads and trackers.",
                        "format": "uint8",
                        "maximum": 2.0,
                        "minimum": 0.0,
                        "type": "integer"
                      },
                      "portForwarding": {
                        "default": false,
                        "description": "Forward one public port to the guest (P2P servers only; qrab-netd\nrenews the mapping).",
                        "type": "boolean"
                      },
                      "server": {
                        "description": "A Proton server name (`CH#12`, `US-GA#445`). Without it the broker\npicks the best eligible server and keeps it while it stays eligible.",
                        "nullable": true,
                        "pattern": "^[A-Za-z0-9-]{2,24}#[0-9]{1,6}(-[A-Za-z]{1,8})?$",
                        "type": "string"
                      },
                      "vpnAccelerator": {
                        "default": true,
                        "description": "VPN Accelerator.",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  }
                },
                "required": [
                  "proton"
                ],
                "type": "object"
              },
              "status": {
                "nullable": true,
                "properties": {
                  "attached": {
                    "description": "The NIC anchors using the profile's Secret (two during a migration).",
                    "items": {
                      "description": "A NIC anchor using a profile.",
                      "properties": {
                        "anchor": {
                          "type": "string"
                        },
                        "nic": {
                          "type": "string"
                        },
                        "node": {
                          "nullable": true,
                          "type": "string"
                        },
                        "vm": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "anchor",
                        "nic",
                        "vm"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "certificateExpires": {
                    "description": "Unix seconds.",
                    "format": "int64",
                    "nullable": true,
                    "type": "integer"
                  },
                  "certificateRenews": {
                    "description": "Unix seconds: when the broker renews the certificate.",
                    "format": "int64",
                    "nullable": true,
                    "type": "integer"
                  },
                  "certifiedFeatures": {
                    "description": "The connection features the certificate binds, as certified.",
                    "nullable": true,
                    "properties": {
                      "moderateNat": {
                        "default": false,
                        "type": "boolean"
                      },
                      "netShield": {
                        "default": 1,
                        "description": "NetShield DNS filtering: 0 off, 1 malware, 2 malware, ads and trackers.",
                        "format": "uint8",
                        "maximum": 255.0,
                        "minimum": 0.0,
                        "type": "integer"
                      },
                      "portForwarding": {
                        "default": false,
                        "type": "boolean"
                      },
                      "vpnAccelerator": {
                        "default": true,
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  },
                  "city": {
                    "nullable": true,
                    "type": "string"
                  },
                  "conditions": {
                    "items": {
                      "description": "A standard condition (`Ready`).",
                      "properties": {
                        "message": {
                          "default": "",
                          "type": "string"
                        },
                        "reason": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "reason",
                        "status",
                        "type"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "configHash": {
                    "description": "SHA-256 of the applied wg.conf, so unchanged configs are not rewritten.",
                    "nullable": true,
                    "type": "string"
                  },
                  "entryCountry": {
                    "nullable": true,
                    "type": "string"
                  },
                  "entryIp": {
                    "nullable": true,
                    "type": "string"
                  },
                  "exitCountry": {
                    "nullable": true,
                    "type": "string"
                  },
                  "forwardedPort": {
                    "description": "The public port Proton forwards to the guest (port forwarding only),\nas the active anchor's qrab-netd mapped it.",
                    "format": "uint16",
                    "maximum": 65535.0,
                    "minimum": 0.0,
                    "nullable": true,
                    "type": "integer"
                  },
                  "load": {
                    "format": "uint8",
                    "maximum": 255.0,
                    "minimum": 0.0,
                    "nullable": true,
                    "type": "integer"
                  },
                  "logicalId": {
                    "nullable": true,
                    "type": "string"
                  },
                  "observedGeneration": {
                    "format": "int64",
                    "nullable": true,
                    "type": "integer"
                  },
                  "physicalId": {
                    "nullable": true,
                    "type": "string"
                  },
                  "portForwardMessage": {
                    "description": "Why there is no forwarded port, when one was asked for.",
                    "nullable": true,
                    "type": "string"
                  },
                  "publicKey": {
                    "description": "The WireGuard public key the certificate covers.",
                    "nullable": true,
                    "type": "string"
                  },
                  "score": {
                    "format": "double",
                    "nullable": true,
                    "type": "number"
                  },
                  "secretName": {
                    "description": "The Secret a NIC references: `vpn-<profile>`.",
                    "nullable": true,
                    "type": "string"
                  },
                  "server": {
                    "nullable": true,
                    "type": "string"
                  },
                  "serverFeatures": {
                    "items": {
                      "description": "Logical-server feature bits, as Proton numbers them.",
                      "enum": [
                        "secureCore",
                        "tor",
                        "p2p",
                        "streaming",
                        "ipv6"
                      ],
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "spec"
            ],
            "title": "VpnProfile",
            "type": "object"
          }
        },
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        }
      }
    ]
  }
}
