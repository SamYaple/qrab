ARG RUST_IMAGE=docker.io/library/rust@sha256:4277ce860337f6cfa1b679891bbf689a447f4b3f4f55701742614ad31321cee7
ARG DEBIAN_IMAGE=docker.io/library/debian@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392
# spire-agent 1.15.3 for guest identity disks; see the spire-agent stage.
ARG SPIRE_AGENT_IMAGE=zot.yapplesauce.com/qrab/spire-agent@sha256:77164ebd4ac2bdcda829dacf7c6242586d56a32dc234cc60f476950237069510
ARG QEMU_IMAGE=localhost/qrab-qemu:11.1.3
FROM ${RUST_IMAGE} AS manager-build
WORKDIR /src
COPY contrib/images/cargo-fresh /usr/local/bin/cargo-fresh
ARG QRAB_REVISION=unknown
COPY Cargo.toml Cargo.lock ./
COPY projects ./projects
RUN --mount=type=cache,id=qrab-cargo-registry,target=/usr/local/cargo/registry --mount=type=cache,id=qrab-manager-target,target=/src/target,sharing=locked cargo-fresh prepare && cargo build --release --locked -p manager --bin qrab-manager -p bmc --bin qrab-bmc -p qrab-redfish --bin qrab-redfish && rustup target add x86_64-unknown-linux-musl && cargo build --release --locked --target x86_64-unknown-linux-musl -p qrab-guest-agent --bin qrab-guest-agent -p qrab-spire-relay --bin qrab-spire-relay && cargo-fresh collect "$QRAB_REVISION" /out /src/target/release/qrab-manager /src/target/release/qrab-bmc /src/target/release/qrab-redfish /src/target/x86_64-unknown-linux-musl/release/qrab-guest-agent /src/target/x86_64-unknown-linux-musl/release/qrab-spire-relay

# The guest's SPIRE agent, carried on each guest-identity VM's qrab-identity
# disk (tools/) so a minimal guest needs no network or package install. It is
# the static spire-agent 1.15.3 the native SPIRE agents on kube01-03 run
# (sha256 3f2f2a7ed936ab13b763b05ce77286d2a30dd68fc57014f0f499c30607730ca6),
# published from there as this internal image.
FROM ${SPIRE_AGENT_IMAGE} AS spire-agent

FROM ${DEBIAN_IMAGE} AS demo-guest
COPY --from=manager-build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY contrib/images/apt-https.sh /usr/local/libexec/qrab-apt-https
RUN sh /usr/local/libexec/qrab-apt-https && apt-get update --error-on=any && apt-get install -y --no-install-recommends linux-image-amd64 busybox-static kmod zstd python3 gzip tpm2-tools systemd-ukify systemd-boot-efi dosfstools mtools fdisk e2fsprogs diffutils && rm -rf /var/lib/apt/lists/*
COPY contrib/images/guest-init /guest/init
COPY contrib/images/make-initramfs.py /make-initramfs.py
COPY contrib/images/prepare-guest.py /prepare-guest.py
COPY contrib/images/guest-disk-probe /guest/usr/bin/qrab-disk-probe
COPY --from=manager-build /out/qrab-guest-agent /guest/usr/sbin/qrab-guest-agent
COPY --from=manager-build /out/qrab-spire-relay /guest/usr/sbin/qrab-spire-relay
COPY contrib/images/guest-update-hook /guest/etc/qrab/update-hook
COPY contrib/images/make-uefi-boot.py /make-uefi-boot.py
RUN python3 /prepare-guest.py && chmod 0755 /guest/init /guest/usr/bin/qrab-disk-probe /guest/usr/sbin/qrab-guest-agent /guest/usr/sbin/qrab-spire-relay /guest/etc/qrab/update-hook && chmod 0755 /guest/etc/qrab && python3 /make-initramfs.py /guest /out/initramfs.gz && python3 /make-uefi-boot.py

FROM ${QEMU_IMAGE}
ARG QRAB_REVISION=unknown
LABEL org.opencontainers.image.source="https://gitea.yapplesauce.com/infrastructure/qrab" \
      org.opencontainers.image.revision="${QRAB_REVISION}" \
      org.opencontainers.image.description="Per-VM QEMU supervisor with optional OIDC BMC and Redfish sidecars and a measured UEFI Linux/TPM2 console fixture"
COPY --from=manager-build /out/qrab-manager /usr/local/bin/qrab-manager
COPY --from=manager-build /out/qrab-bmc /usr/local/bin/qrab-bmc
COPY --from=manager-build /out/qrab-redfish /usr/local/bin/qrab-redfish
COPY --from=manager-build /out/build-revision /usr/share/qrab/build-revision
# guest_identity.guest_tools_dir: copied into the qrab-identity disk's tools/.
COPY --from=manager-build /out/qrab-spire-relay /usr/libexec/qrab/guest-tools/qrab-spire-relay
COPY --from=spire-agent /spire-agent /usr/libexec/qrab/guest-tools/spire-agent
COPY projects/bmc/assets /opt/qrab/bmc/assets
ENV BMC_ASSETS_DIR=/opt/qrab/bmc/assets
COPY --from=demo-guest /out /opt/qrab/demo
COPY contrib/kubernetes/vm.json /etc/qrab/vm.json
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/qrab-manager"]
CMD ["run", "--config", "/etc/qrab/vm.json"]
