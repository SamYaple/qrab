ARG RUST_IMAGE=docker.io/library/rust@sha256:4277ce860337f6cfa1b679891bbf689a447f4b3f4f55701742614ad31321cee7
ARG DEBIAN_IMAGE=docker.io/library/debian@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392
ARG QEMU_IMAGE=localhost/qrab-qemu:11.1.3
FROM ${RUST_IMAGE} AS manager-build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY projects ./projects
RUN --mount=type=cache,id=qrab-cargo-registry,target=/usr/local/cargo/registry --mount=type=cache,id=qrab-manager-target,target=/src/target,sharing=locked cargo build --release --locked -p manager --bin qrab-manager -p bmc --bin qrab-bmc -p qrab-redfish --bin qrab-redfish && rustup target add x86_64-unknown-linux-musl && cargo build --release --locked --target x86_64-unknown-linux-musl -p qrab-guest-agent --bin qrab-guest-agent && mkdir -p /out && cp /src/target/release/qrab-manager /src/target/release/qrab-bmc /src/target/release/qrab-redfish /src/target/x86_64-unknown-linux-musl/release/qrab-guest-agent /out/

FROM ${DEBIAN_IMAGE} AS demo-guest
RUN apt-get update && apt-get install -y --no-install-recommends linux-image-amd64 busybox-static kmod zstd python3 gzip tpm2-tools systemd-ukify systemd-boot-efi dosfstools mtools fdisk e2fsprogs diffutils && rm -rf /var/lib/apt/lists/*
COPY contrib/images/guest-init /guest/init
COPY contrib/images/make-initramfs.py /make-initramfs.py
COPY contrib/images/prepare-guest.py /prepare-guest.py
COPY contrib/images/guest-disk-probe /guest/usr/bin/qrab-disk-probe
COPY --from=manager-build /out/qrab-guest-agent /guest/usr/sbin/qrab-guest-agent
COPY contrib/images/guest-update-hook /guest/etc/qrab/update-hook
COPY contrib/images/make-uefi-boot.py /make-uefi-boot.py
RUN python3 /prepare-guest.py && chmod 0755 /guest/init /guest/usr/bin/qrab-disk-probe /guest/usr/sbin/qrab-guest-agent /guest/etc/qrab/update-hook && chmod 0755 /guest/etc/qrab && python3 /make-initramfs.py /guest /out/initramfs.gz && python3 /make-uefi-boot.py

# passt for NIC pods, from the Debian source in the base image's snapshot plus
# contrib/images/passt/*.patch in order: 0001 adds --no-ns-isolation (a
# restricted pod's RuntimeDefault seccomp refuses the namespaces passt would
# create itself); 0002 fixes a crash on inbound TCP before a guest attaches;
# 0003 lets --ns-mac-addr preset the guest MAC in passt mode.
FROM ${DEBIAN_IMAGE} AS passt-build
ARG PASST_VERSION=0.0~git20250503.587980c-2+deb13u1
COPY contrib/images/passt /passt
RUN cp /passt/snapshot.sources /etc/apt/sources.list.d/passt-src.sources && apt-get update && apt-get install -y --no-install-recommends dpkg-dev gcc libc6-dev make patch xz-utils \
 && mkdir /build && cd /build && apt-get source --download-only "passt=${PASST_VERSION}" \
 && sha256sum -c /passt/source.sha256 \
 && dpkg-source -x "passt_${PASST_VERSION}.dsc" src && cd src && for p in /passt/*.patch; do patch -p1 --no-backup-if-mismatch < "$p" || exit 1; done \
 && export DEB_BUILD_MAINT_OPTIONS=hardening=+all && make passt VERSION="${PASST_VERSION}+qrab3" CFLAGS="$(dpkg-buildflags --get CFLAGS)" CPPFLAGS="$(dpkg-buildflags --get CPPFLAGS)" LDFLAGS="$(dpkg-buildflags --get LDFLAGS)" \
 && install -D -m 0755 passt /out/passt && /out/passt --version | head -1 && /out/passt --help | grep -q -- --no-ns-isolation

FROM ${QEMU_IMAGE}
ARG QRAB_REVISION=unknown
LABEL org.opencontainers.image.source="https://gitea.yapplesauce.com/infrastructure/qrab" \
      org.opencontainers.image.revision="${QRAB_REVISION}" \
      org.opencontainers.image.description="Per-VM QEMU supervisor with optional OIDC BMC and Redfish sidecars and a measured UEFI Linux/TPM2 console fixture"
COPY --from=manager-build /out/qrab-manager /usr/local/bin/qrab-manager
COPY --from=manager-build /out/qrab-bmc /usr/local/bin/qrab-bmc
COPY --from=manager-build /out/qrab-redfish /usr/local/bin/qrab-redfish
COPY --from=passt-build /out/passt /usr/bin/passt
COPY projects/bmc/assets /opt/qrab/bmc/assets
ENV BMC_ASSETS_DIR=/opt/qrab/bmc/assets
COPY --from=demo-guest /out /opt/qrab/demo
COPY contrib/kubernetes/vm.json /etc/qrab/vm.json
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/qrab-manager"]
CMD ["run", "--config", "/etc/qrab/vm.json"]
