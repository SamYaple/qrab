ARG DEBIAN_IMAGE=docker.io/library/debian@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392
FROM ${DEBIAN_IMAGE} AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential python3 python3-venv python3-pip python3-setuptools python3-wheel ninja-build meson pkg-config libglib2.0-dev libpixman-1-dev zlib1g-dev libfdt-dev libiscsi-dev && rm -rf /var/lib/apt/lists/*
COPY qemu-source /src/qemu
WORKDIR /build
RUN /src/qemu/configure --prefix=/opt/qemu --target-list=x86_64-softmmu --without-default-features --enable-tcg --enable-kvm --enable-vnc --enable-pixman --enable-tpm --enable-libiscsi --disable-guest-agent --disable-docs --disable-werror --disable-download && ninja -j 8 && ninja install
RUN strip /opt/qemu/bin/qemu-system-x86_64

FROM ${DEBIAN_IMAGE}
ARG QRAB_REVISION=unknown
LABEL org.opencontainers.image.source="https://gitea.yapplesauce.com/infrastructure/qrab" \
      org.opencontainers.image.revision="${QRAB_REVISION}" \
      org.opencontainers.image.version="11.1.3" \
      io.qrab.qemu.source="https://gitea.yapplesauce.com/mirrors/qemu.git" \
      io.qrab.qemu.revision="005c61c0ef6f6ae615283440b4bb7be51b2c6ddd"
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0t64 libpixman-1-0 zlib1g libfdt1 libiscsi7 ca-certificates ovmf swtpm && install -D -m 0644 /usr/share/OVMF/OVMF_CODE_4M.fd /opt/qrab/firmware/OVMF_CODE_4M.fd && install -D -m 0644 /usr/share/OVMF/OVMF_VARS_4M.fd /opt/qrab/firmware/OVMF_VARS_4M.fd && mkdir -p /usr/share/doc/qrab-qemu && dpkg-query -W ovmf swtpm libtpms0 libiscsi7 > /usr/share/doc/qrab-qemu/runtime-packages.txt && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/qemu /opt/qemu
COPY --from=build /src/qemu/COPYING /usr/share/doc/qrab-qemu/COPYING
COPY qemu-source.json /usr/share/doc/qrab-qemu/source.json
ENV PATH="/opt/qemu/bin:$PATH"
USER 10001:10001
ENTRYPOINT ["/opt/qemu/bin/qemu-system-x86_64"]
CMD ["--version"]
