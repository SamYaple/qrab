ARG RUST_IMAGE=docker.io/library/rust@sha256:4277ce860337f6cfa1b679891bbf689a447f4b3f4f55701742614ad31321cee7
ARG DEBIAN_IMAGE=docker.io/library/debian@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392
# qemu-img (vendor/qemu with libiscsi) for the image importer's Jobs.
ARG QEMU_IMAGE
FROM ${QEMU_IMAGE} AS qemu
FROM ${RUST_IMAGE} AS build
WORKDIR /src
COPY contrib/images/cargo-fresh /usr/local/bin/cargo-fresh
ARG QRAB_REVISION=unknown
COPY Cargo.toml Cargo.lock ./
COPY projects ./projects
RUN --mount=type=cache,id=qrab-cargo-registry,target=/usr/local/cargo/registry --mount=type=cache,id=qrab-operator-target,target=/src/target,sharing=locked cargo-fresh prepare && cargo build --release --locked -p qrab-operator --bin qrab-operator -p qrab-kvm-device-plugin --bin qrab-kvm-device-plugin -p qrab-netd --bin qrab-netd -p qrab-proton --bin qrab-proton -p qrab-observability --bin qrab-observability && cargo-fresh collect "$QRAB_REVISION" /out /src/target/release/qrab-operator /src/target/release/qrab-kvm-device-plugin /src/target/release/qrab-netd /src/target/release/qrab-proton /src/target/release/qrab-observability

FROM ${DEBIAN_IMAGE}
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY contrib/images/apt-https.sh /usr/local/libexec/qrab-apt-https
ARG QRAB_REVISION=unknown
LABEL org.opencontainers.image.source="https://gitea.yapplesauce.com/infrastructure/qrab" \
      org.opencontainers.image.revision="${QRAB_REVISION}" \
      org.opencontainers.image.description="Minimal namespaced qrab VirtualMachine operator"
RUN sh /usr/local/libexec/qrab-apt-https && apt-get update --error-on=any && apt-get install -y --no-install-recommends ca-certificates iproute2 nftables wireguard-tools libglib2.0-0t64 zlib1g libiscsi7 && rm -rf /var/lib/apt/lists/*
COPY --from=qemu /opt/qemu/bin/qemu-img /opt/qemu/bin/qemu-img
COPY --from=build /out/qrab-operator /out/qrab-kvm-device-plugin /out/qrab-netd /out/qrab-proton /out/qrab-observability /usr/local/bin/
COPY --from=build /out/build-revision /usr/share/qrab/build-revision
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/qrab-operator"]
