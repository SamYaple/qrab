[Unit]
Description=Destroy qrab VM disks retired more than 7 days ago
After=qrab-iscsi-target.service zfs-volumes.target
ConditionPathExists=/var/lib/qrab-iscsi-target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ExecStart=/usr/local/sbin/qrab-iscsi-target vm-disk-reap --older-than-days 7 --mode apply
TimeoutStartSec=1800
