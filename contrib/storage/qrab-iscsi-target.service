[Unit]
Description=Restore owned qrab iSCSI targets
Requires=sys-kernel-config.mount
Wants=network-online.target
After=sys-kernel-config.mount network-online.target zfs-volumes.target
ConditionPathExists=/var/lib/qrab-iscsi-target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ExecStartPre=/usr/local/sbin/qrab-iscsi-target bootstrap
ExecStart=/usr/local/sbin/qrab-iscsi-target restore
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
