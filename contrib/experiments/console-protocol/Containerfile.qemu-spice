# Experiment only: contrib/images/Containerfile.qemu plus SPICE and usb-redir,
# built from the same pinned, unmodified QEMU source (vendor/qemu 005c61c0, 11.1.3).
# Build context: a directory holding `qemu-source/` (see README.md, experiment B0).
ARG DEBIAN_IMAGE=docker.io/library/debian@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392
FROM ${DEBIAN_IMAGE} AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential python3 python3-venv python3-pip python3-setuptools python3-wheel ninja-build meson pkg-config libglib2.0-dev libpixman-1-dev zlib1g-dev libfdt-dev libiscsi-dev \
      libspice-server-dev libspice-protocol-dev libusbredirparser-dev && rm -rf /var/lib/apt/lists/*
COPY qemu-source /src/qemu
WORKDIR /build
RUN /src/qemu/configure --prefix=/opt/qemu --target-list=x86_64-softmmu --without-default-features --enable-tcg --enable-kvm --enable-vnc --enable-pixman --enable-tpm --enable-libiscsi \
      --enable-spice --enable-spice-protocol --enable-usb-redir \
      --disable-guest-agent --disable-docs --disable-werror --disable-download && ninja -j 32 && ninja install
RUN strip /opt/qemu/bin/qemu-system-x86_64

FROM ${DEBIAN_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0t64 libpixman-1-0 zlib1g libfdt1 libiscsi7 libspice-server1 libusbredirparser1t64 && dpkg-query -W libspice-server1 libusbredirparser1t64 libopus0 > /runtime-packages.txt && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/qemu /opt/qemu
ENV PATH="/opt/qemu/bin:$PATH"
USER 10001:10001
ENTRYPOINT ["/opt/qemu/bin/qemu-system-x86_64"]
CMD ["--version"]
