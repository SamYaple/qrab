+/* Request a fresh MKA key without discarding receive-channel state.
+ * The root-owned local control socket is the only caller. No key material
+ * or packet numbers are supplied by the caller. */
+int ieee802_1x_kay_request_rekey(struct ieee802_1x_kay *kay)
+{
+	struct ieee802_1x_mka_participant *principal;
+
+	if (!kay)
+		return -1;
+	principal = ieee802_1x_kay_get_principal_participant(kay);
+	if (!principal)
+		return -1;
+
+	if (principal->is_key_server)
+		principal->new_sak = true;
+	else if (!reset_participant_mi(principal))
+		return -1;
+
+	/* The key server uses the existing generation/distribution state
+	 * machine. A client proves a fresh MI, asking the key server for a
+	 * fresh key while retaining its local receive channels. */
+	ieee802_1x_participant_send_mkpdu(principal);
+	return 0;
+}
