## @file
#  QrabSbAutoEnroll — DXE driver that invokes OvmfPkg/EnrollDefaultKeys.efi
#  from the FV when PK is absent.
#
#  Upstream edk2 ships EnrollDefaultKeys as a UEFI_APPLICATION (shell app).
#  That leaves a fresh AmdSev firmware in Setup Mode until the operator
#  runs the app from a UEFI shell — which never happens in a headless
#  SNP guest. This driver closes the gap: at DXE dispatch it checks
#  whether PK is enrolled, and if not, it LoadImage+StartImages the
#  shell application directly from the FV via its FILE_GUID.
#
#  Copyright (c) 2026 qrab contributors.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = QrabSbAutoEnroll
  FILE_GUID                      = 9F4D3C21-5B8A-4D3E-8F71-0E2B43A6D5C7
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = QrabSbAutoEnrollEntry

[Sources]
  QrabSbAutoEnroll.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  OvmfPkg/OvmfPkg.dec

[LibraryClasses]
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiDriverEntryPoint
  UefiLib
  DebugLib
  DevicePathLib
  MemoryAllocationLib

[Guids]
  gEfiGlobalVariableGuid          ## CONSUMES

[Protocols]
  gEfiFirmwareVolume2ProtocolGuid ## CONSUMES
  gEfiShellParametersProtocolGuid ## PRODUCES

[Depex]
  gEfiVariableArchProtocolGuid AND
  gEfiVariableWriteArchProtocolGuid
